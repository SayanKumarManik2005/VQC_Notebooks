 Training Loop with Information Loss Minimization (Dual Loss)\n","# Loss = L_classification (BCE) + lambda_info * L_reconstruction (MSE)\n","# =========================================================================\n","\n","def train_epoch(model, dataloader, optimizer, criterion, lambda_info=0.05):\n","    model.train()\n","    criterion_mse = nn.MSELoss()\n","    total_loss = 0.0\n","    total_cls_loss = 0.0\n","    total_info_loss = 0.0\n","    all_preds, all_gold = [], []\n","\n","    for input_ids, attn_mask, labels in tqdm(dataloader, desc='Training'):\n","        input_ids = input_ids.to(gpu_device)\n","        attn_mask = attn_mask.to(gpu_device)\n","        labels    = labels.to(gpu_device)       # (B, NUM_LABELS) float32\n","\n","        optimizer.zero_grad()\n","        \n","        # Model returns classification logits + reconstructed features during training\n","        logits, rec_text, orig_text, rec_latent, orig_latent = model(input_ids, attn_mask)\n","        \n","        # 1. Emotion Classification Loss (BCEWithLogitsLoss)\n","        loss_cls = criterion(logits, labels)\n","        \n","        # 2. Information Loss: Penalizes loss of information in 768->128 and 128->4 compression\n","        loss_rec_text = criterion_mse(rec_text, orig_text.detach())\n","        loss_rec_latent = criterion_mse(rec_latent, orig_latent.detach())\n","        loss_info = loss_rec_text + loss_rec_latent\n","        \n","        # Total Dual-Objective Loss\n","        loss = loss_cls + lambda_info * loss_info\n","        \n","        loss.backward()\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n","        optimizer.step()\n","\n","        total_loss += loss.item()\n","        total_cls_loss += loss_cls.item()\n","        total_info_loss += loss_info.item()\n","        \n","        preds = (torch.sigmoid(logits) > 0.5).detach().cpu().numpy().astype(int)\n","        all_preds.append(preds)\n","        all_gold.append(labels.detach().cpu().numpy().astype(int))\n","\n","    all_preds = np.vstack(all_preds)\n","    all_gold  = np.vstack(all_gold)\n","    macro_f1  = f1_score(all_gold, all_preds, average='macro', zero_division=0)\n","\n","    avg_loss = total_loss / len(dataloader)\n","    avg_cls  = total_cls_loss / len(dataloader)\n","    avg_info = total_info_loss / len(dataloader)\n","    \n","    print(f\"   [Train Loss Breakdown] Cls (BCE): {avg_cls:.4f} | Info Loss (MSE): {avg_info:.4f}\")\n","    return avg_loss, macro_f1\n"]},{"cell_type":"code","execution_count":19,"id":"d705cb6b","metadata":{"execution":{"iopub.execute_input":"2026-11-24T21:17:41.122409Z","iopub.status.busy":"2026-11-24T21:17:41.11846Z","iopub.status.idle":"2026-11-24T21:17:41.160384Z","shell.execute_reply":"2026-11-24T21:17:41.156933Z"},"papermill":{"duration":0.083086,"end_time":"2026-11-24T21:17:41.163965+00:00","exception":false,"start_time":"2026-11-24T21:17:41.080879+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def evaluate(model, dataloader, criterion, threshold=0.5):\n","    model.eval()\n","    total_loss = 0.0\n","    all_preds, all_gold = [], []\n","\n","    with torch.no_grad():\n","        for input_ids, attn_mask, labels in dataloader:\n","            input_ids = input_ids.to(gpu_device)\n","            attn_mask = attn_mask.to(gpu_device)\n","            labels    = labels.to(gpu_device)\n","\n","            # In eval mode, model directly returns logits (pure quantum output)\n","            logits = model(input_ids, attn_mask)\n","            loss   = criterion(logits, labels)\n","            total_loss += loss.item()\n","\n","            preds = (torch.sigmoid(logits) > threshold).cpu().numpy().astype(int)\n","            all_preds.append(preds)\n","            all_gold.append(labels.cpu().numpy().astype(int))\n","\n","    all_preds = np.vstack(all_preds)\n","    all_gold  = np.vstack(all_gold)\n","\n","    # ── existing metrics ──────────────────────────────────────\n","    base_metrics = {\n","        'loss'         : total_loss / len(dataloader),\n","        'macro_f1'     : f1_score(all_gold, all_preds, average='macro',    zero_division=0),\n","        'micro_f1'     : f1_score(all_gold, all_preds, average='micro',    zero_division=0),\n","        'weighted_f1'  : f1_score(all_gold, all_preds, average='weighted', zero_division=0),\n","        'hamming_loss' : hamming_loss(all_gold, all_preds),\n","        'preds'        : all_preds,\n","        'gold'         : all_gold,\n","    }\n","\n","    # ── new schemes (Exact Match + Partial Match) ─────────────\n","    extended = evaluate_all_schemes(\n","        gold        = all_gold,\n","        preds       = all_preds,\n","        label_names = EMOTION_COLS,\n","        verbose     = False,\n","    )\n","    base_metrics['exact_match']   = extended['scheme2']\n","    base_metrics['partial_match'] = extended['scheme3']\n","\n","    return base_metrics\n"]},{"cell_type":"code","execution_count":20,"id":"5b20044d","metadata":{"execution":{"iopub.execute_input":"2026-11-24T21:17:41.209642Z","iopub.status.busy":"2026-11-24T21:17:41.20921Z","iopub.status.idle":"2026-11-24T21:17:41.23064Z","shell.execute_reply":"2026-11-24T21:17:41.229637Z"},"papermill":{"duration":0.048742,"end_time":"2026-11-24T21:17:41.235855+00:00","exception":false,"start_time":"2026-11-24T21:17:41.187113+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class EarlyStopping:\n","    def __init__(self, patience=5, min_delta=1e-4):\n","        self.patience   = patience\n","        self.min_delta  = min_delta\n","        self.best_score = None\n","        self.counter    = 0\n","        self.best_state = None\n","\n","    def step(self, score, model):\n","        if self.best_score is None or score > self.best_score + self.min_delta:\n","            self.best_score = score\n","            self.counter    = 0\n","            self.best_state = {\n","                k: v.detach().cpu() for k, v in model.state_dict().items()\n","