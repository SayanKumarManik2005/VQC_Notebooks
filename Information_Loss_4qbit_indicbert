ds=input_ids,\n","            attention_mask=attention_mask\n","        ).last_hidden_state[:, 0, :]   # Shape: (B, 768)\n","\n","        # 2. Compress 768 -> 128\n","        text_comp = self.text_compressed(text_feat)   # Shape: (B, 128)\n","\n","        # 3. Pass through Quantum Fusion (128 -> 4 -> VQC -> 128)\n","        q_out, rec_latent, target_latent = self.quantum_fusion(text_comp)\n","\n","        # 4. Global reconstruction for text feature preservation\n","        rec_text = self.text_decoder(text_comp)\n","\n","        # 5. Classification prediction (solely from VQC)\n","        logits = self.classifier(F.relu(q_out))\n","\n","        if self.training:\n","            return logits, rec_text, text_feat, rec_latent, target_latent\n","        return logits\n"]},{"cell_type":"code","execution_count":16,"id":"f744525d","metadata":{"execution":{"iopub.execute_input":"2026-11-24T21:17:40.735252Z","iopub.status.busy":"2026-11-24T21:17:40.731537Z","iopub.status.idle":"2026-11-24T21:17:40.757231Z","shell.execute_reply":"2026-11-24T21:17:40.756294Z"},"papermill":{"duration":0.076676,"end_time":"2026-11-24T21:17:40.761971+00:00","exception":false,"start_time":"2026-11-24T21:17:40.685295+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train batches: 2303 | Val: 256 | Test: 284\n"]}],"source":["MAX_LEN    = 128\n","BATCH_SIZE = 8\n","\n","train_dataset = EmoNoBaDataset(df_tr, tokenizer, MAX_LEN)\n","val_dataset   = EmoNoBaDataset(df_vl, tokenizer, MAX_LEN)\n","test_dataset  = EmoNoBaDataset(df_te, tokenizer, MAX_LEN)\n","\n","\n","def seed_worker(worker_id):\n","    worker_seed = torch.initial_seed() % 2**32\n","    np.random.seed(worker_seed)\n","    random.seed(worker_seed)\n","\n","g = torch.Generator()\n","g.manual_seed(42)\n","\n","train_loader = DataLoader(\n","    train_dataset, batch_size=BATCH_SIZE, shuffle=True,\n","    worker_init_fn=seed_worker, generator=g\n",")\n","val_loader   = DataLoader(\n","    val_