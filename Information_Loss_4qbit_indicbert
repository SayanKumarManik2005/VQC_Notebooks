\n","weights = np.random.random((1,4,3))\n","\n","print(vqc(inputs, weights))\n","\n","# Draw the circuit\n","fig, ax = qml.draw_mpl(vqc)(inputs, weights)\n","plt.show()"]},{"cell_type":"code","execution_count":13,"id":"9f223095","metadata":{"execution":{"iopub.execute_input":"2026-11-24T21:17:40.303286Z","iopub.status.busy":"2026-11-24T21:17:40.298765Z","iopub.status.idle":"2026-11-24T21:17:40.331767Z","shell.execute_reply":"2026-11-24T21:17:40.33014Z"},"papermill":{"duration":0.083135,"end_time":"2026-11-24T21:17:40.337882+00:00","exception":false,"start_time":"2026-11-24T21:17:40.254747+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class QuantumBottleneck(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        # StronglyEntanglingLayers weight shape: (n_layers, n_qubits, 3)\n","        self.weights = nn.Parameter(\n","            torch.randn(n_qlayers, n_qubits, 3)   # ← was (N_Q_LAYERS, N_QUBITS)\n","        )\n","\n","    def forward(self, x):\n","        outputs = []\n","        for i in range(x.shape[0]):\n","            out = torch.stack(vqc(x[i].cpu(),self.weights.cpu())).to(x.device)\n","            outputs.append(out)\n","        return torch.stack(outputs)"]},{"cell_type":"code","execution_count":null,"id":"f4f16cde","metadata":{"papermill":{"duration":0.042387,"end_time":"2026-11-24T21:17:40.422623+00:00","exception":false,"start_time":"2026-11-24T21:17:40.380236+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]},{"cell_type":"code","execution_count":14,"id":"41c42c1d","metadata":{"execution":{"iopub.execute_input":"2026-11-24T21:17:40.469083Z","iopub.status.busy":"2026-11-24T21:17:40.468355Z","iopub.status.idle":"2026-11-24T21:17:40.501081Z","shell.execute_reply":"2026-11-24T21:17:40.499896Z"},"papermill":{"duration":0.062174,"end_time":"2026-11-24T21:17:40.50493+00:00","exception":false,"start_time":"2026-11-24T21:17:40.442756+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# =========================================================================\n","# MODIFIED: Information-Preserving Quantum Fusion Layer\n","# Retains the exact 4-qubit pure quantum pipeline, but introduces an\n","# auxiliary decoder to minimize information loss during 128 -> 4 reduction.\n","# =========================================================================\n","\n","class InformationPreservingQuantumFusionLayer(nn.Module):\n","    def __init__(self, in_dim=128, q_dim=4):\n","        super().__init__()\n","        assert q_dim == n_qubits, \"q_dim must match n_qubits\"\n","\n","        # Pre-quantum projection: in_dim (128) -> q_dim (4)\n","        self.pre_q = nn.Linear(in_dim, q_dim)\n","        \n","        # Auxiliary Information-Preservation Decoder: 4 -> in_dim (128)\n","        # Forces the 4 latent numbers to retain sufficient information to reconstruct 128\n","        self.info_decoder = nn.Sequential(\n","            nn.Linear(q_dim, in_dim),\n","            nn.ReLU()\n","        )\n","\n","        # Exact same 4-qubit PennyLane VQC bottleneck\n","        self.quantum = QuantumBottleneck()\n","        \n","        # Post-quantum projection: q_dim (4) -> in_dim (128)\n","        self.post_q  = nn.Linear(q_dim, in_dim)\n","\n","    def forward(self, x):\n","        # 1. Compress to 4 latent values\n","        z_q = self.pre_q(x)\n","        \n","        # 2. Scale to full [-pi, pi] rotation range (Bloch sphere full utilization)\n","        angles = torch.pi * torch.tanh(z_q)\n","        \n","        # 3. Information reconstruction to calculate information loss during training\n","        reconstructed_latent = self.info_decoder(z_q)\n","        \n","        # 4. Pure 4-qubit VQC execution\n","        q_out = self.quantum(angles.to(cpu_device))\n","        q_out = q_out.to(x.device).float()\n","\n","        # 5. Project 4 quantum outputs back to 128\n","        out = self.post_q(q_out)\n","        \n","        return out, reconstructed_latent, x\n"]},{"